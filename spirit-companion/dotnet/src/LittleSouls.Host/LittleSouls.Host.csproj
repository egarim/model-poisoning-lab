<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The Little Souls server: Singular's data-plane API, compiled UNCHANGED from its source at the pinned commit (the way
    Creatura.Shim compiles Creatura), plus the Little Souls module. Singular's Program.cs has no plugin loader, so the
    module comes in through an ASP.NET hosting startup in this assembly (LittleSoulsStartup.cs), which ASP.NET runs for
    the application's own assembly: AddLittleSoulsApp, the daemon turn endpoint and the web app. Nothing in Singular is
    edited; updating Singular is moving the pin in tools/get-singular.sh.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LittleSouls.Host</RootNamespace>
    <NoWarn>$(NoWarn);CS1591;CS8604;CS8602;CS8600;CS8619;CS8620</NoWarn>
    <SingularApi>$(MSBuildThisFileDirectory)../../../external/singular-framework/src/SingularFramework.Api/</SingularApi>
    <SingularSrc>$(MSBuildThisFileDirectory)../../../external/singular-framework/src/</SingularSrc>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(SingularApi)**/*.cs" Exclude="$(SingularApi)obj/**;$(SingularApi)bin/**" LinkBase="Singular" />
    <ProjectReference Include="$(SingularSrc)SingularFramework.Platform/SingularFramework.Platform.csproj" />
    <ProjectReference Include="$(SingularSrc)SingularFramework.Apps.Cosmos/SingularFramework.Apps.Cosmos.csproj" />
    <ProjectReference Include="../SingularFramework.Apps.LittleSouls/SingularFramework.Apps.LittleSouls.csproj" />
    <ProjectReference Include="../LittleSouls.Daemon/LittleSouls.Daemon.csproj" />
    <ProjectReference Include="../Creatura.Seats.Shim/Creatura.Seats.Shim.csproj" />
  </ItemGroup>

  <Target Name="CheckSingularApiSource" BeforeTargets="BeforeBuild" Condition="!Exists('$(SingularApi)Program.cs')">
    <Error Text="Singular's source is missing: run tools/get-singular.sh first." />
  </Target>

</Project>
